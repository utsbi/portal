NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional comma-separated hosts allowed to access `next dev` over LAN/Tailscale.
NEXT_DEV_ALLOWED_ORIGINS=
# Production only: share the auth session cookie with subdomains so
# docs.utsbi.org can gate the docs behind portal login. Leave unset locally.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# Origin of the docs app that /docs is proxied to (default https://docs.utsbi.org)
DOCS_APP_URL=
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=
N8N_CONTACT_WEBHOOK_URL=
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
DISCORD_CONTACT_WEBHOOK_URL=
DISCORD_FORM_WEBHOOK_URL=
ASSEMBLYAI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=SBI Portal <notifications@utsbi.org>
EMAIL_TIME_ZONE=America/Chicago
