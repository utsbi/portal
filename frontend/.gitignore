# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.omc/
.sisyphus/

# Agent / tooling sidecar dirs. CRITICAL: Tailwind v4 walks the project tree
# on every compile to scan for class usage. .claude/ in particular can grow
# to 500+MB / 6000+ files (session logs, prompts, artifacts), and scanning
# it OOM's PostCSS — postcss.js worker climbed past 10GB during dev compile
# before being killed. Keep these dirs ignored both for git AND Tailwind.
.claude/
.impeccable/
.superpowers/

# Playwright MCP scratch output (screenshots, snapshots, console logs)
.playwright-mcp/
