# OpenRouter API
OPEN_ROUTER_KEY=your_open_router_key_here

# Chat Models (OpenRouter model IDs)
# Both must be tool-capable (they run the agent loop); both are natively
# multimodal so image attachments can be passed as pixels, not transcribed.
FAST_MODEL=xiaomi/mimo-v2.5
THINK_MODEL=minimax/minimax-m3

# TITLE_MODEL generates short conversation titles. Titling runs in parallel with
# the first answer (it never blocks the stream). Optional — falls back to
# FAST_MODEL when unset. Point it at the cheapest model to minimize title cost.
TITLE_MODEL=ibm-granite/granite-4.1-8b

# Embedding Model
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1536

# Reranker (OpenRouter rerank endpoint). Leave RERANK_MODEL empty to disable.
RERANK_MODEL=cohere/rerank-4-pro
RERANK_CANDIDATES=30
RERANK_TOP_N=8

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLIC_KEY=your_anon_public_key
SUPABASE_SECRET_KEY=your_service_role_secret_key

# Security / hardening (development defaults shown).
# ENV: set to "production" to disable /docs,/redoc,/openapi and enable HSTS.
ENV=development
# Production requires explicit HTTPS CORS_ORIGINS and rejects "*".
CORS_ORIGINS=http://localhost:3000
# Production requires an explicit Host-header allowlist and rejects "*".
ALLOWED_HOSTS=*
# MAX_UPLOAD_BYTES: max size for uploads / text extraction (default 10 MB).
MAX_UPLOAD_BYTES=10485760
# PORTAL_BASE_URL: base URL of the Next.js frontend. The get_upcoming_events
# tool proxies the frontend's /api/contact/calendar/client-events route
# (native project_events under RLS). Production requires an HTTPS value.
PORTAL_BASE_URL=http://localhost:3000
