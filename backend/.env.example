# OpenRouter API
OPEN_ROUTER_KEY=your_open_router_key_here

# Chat Models (OpenRouter model IDs)
# FAST_MODEL drives the tool-calling agent loop, so it MUST be a tool-capable model.
FAST_MODEL=deepseek/deepseek-v4-flash
# THINK_MODEL is used for the final answer when model_preference="thinking".
# Ring supports tool calls + structured outputs (deepseek-v4-pro lacks tool support).
THINK_MODEL=inclusionai/ring-2.6-1t

# TITLE_MODEL generates short conversation titles. Titling runs in parallel with
# the first answer (it never blocks the stream). Optional — falls back to
# FAST_MODEL when unset. Point it at the cheapest model to minimize title cost.
TITLE_MODEL=deepseek/deepseek-v4-flash

# Embedding Model
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1536

# Vision model for image attachments (chat models are text-only; images are
# transcribed once at attach time). Leave empty to disable image attachments.
VISION_MODEL=google/gemini-2.5-flash-lite

# Reranker (OpenRouter rerank endpoint). Leave RERANK_MODEL empty to disable.
RERANK_MODEL=cohere/rerank-4-pro
RERANK_CANDIDATES=30
RERANK_TOP_N=8

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLIC_KEY=your_anon_public_key
SUPABASE_SECRET_KEY=your_service_role_secret_key

# Security / hardening (all optional; safe defaults shown)
# ENV: set to "production" to disable /docs,/redoc,/openapi and enable HSTS.
ENV=development
# CORS_ORIGINS: comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# ALLOWED_HOSTS: comma-separated Host-header allowlist ("*" allows any).
ALLOWED_HOSTS=*
# MAX_UPLOAD_BYTES: max size for uploads / text extraction (default 10 MB).
MAX_UPLOAD_BYTES=10485760
